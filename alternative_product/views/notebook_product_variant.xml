<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_variant_notebook" model="ir.ui.view">
        <field name="name">product_variant_notebook_alternative</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Alternative Product" groups="alternative_product.alternative_product_group">
                    <group>

                        <field name="alternative_products" widget="many2many_tags"/>

                    </group>

                </page>

            </notebook>
        </field>

    </record>
</odoo>

